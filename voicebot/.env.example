# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# ── STT: Qwen ASR realtime websocket (Roman Urdu out) ────────────────────────
QWEN_VLLM_BASE_URL=wss://ebitlogix-qwen-asr-vlm-async-test.hf.space/en/v1/realtime
QWEN_VLLM_TOKEN=

# ── TTS: OmniVoice websocket ────────────────────────────────────────────────
OMNI_TTS=wss://ebitlogix-omnivoice-tts-api.hf.space/ws/tts
OMNI_TTS_TOKEN=

# ── LLM: Qwen3-8B, OpenAI-compatible endpoint (vLLM or llama.cpp) ───────────
# Not provided yet. Example: https://host:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B

# ── LiveKit (self-hosted). Dev values match `livekit-server --dev` ──────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Router: which model decides continue / switch / side-question / human ───
# Primary is tried first; fallback runs when the primary errors, times out, or is
# below its confidence threshold. Values: laya | qwen | shortlist | none
ROUTER_PRIMARY=qwen          # laya | qwen | none. Laya zero-shot failed the Roman Urdu bake-off (22% accuracy, 1.3s+ on CPU); keep qwen until Laya is fine-tuned
ROUTER_FALLBACK=none         # secondary model router; the rule-based baseline always runs last
ROUTER_FALLBACK_ON=error,timeout,low_confidence
ROUTER_TIMEOUT_MS=400
# Laya (local, open-source). Checkpoint: laya-multilingual | laya | laya-typed-decisions
# or a path to your fine-tuned checkpoint.
LAYA_MODEL=laya-multilingual
LAYA_DEVICE=auto            # auto | cpu | cuda | mps
LAYA_CONFIDENCE_MIN=0.80    # below this -> fallback router. Re-tune after calibration.
LAYA_TEMPERATURE=1.0        # set to the calibrated value after fine-tuning
# Qwen router (reuses LLM_* above)
ROUTER_QWEN_CONFIDENCE_MIN=0.70
ROUTER_SHORTLIST_SIZE=4     # candidate workflows passed to the router
ROUTER_SWITCH_CONFIDENCE_MIN=0.85   # extra bar for leaving a half-finished workflow
ROUTER_LOG_DECISIONS=true   # training data for later fine-tuning

# ── LLM generation (Qwen3-8B) ───────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=80
LLM_ENABLE_THINKING=false

# ── STT / TTS behaviour ─────────────────────────────────────────────────────
STT_LANGUAGE=ur
STT_SAMPLE_RATE=16000
TTS_VOICE=
TTS_SAMPLE_RATE=24000
TTS_SCRIPT=roman            # roman | urdu  (what the TTS expects as input)

# ── Voice activity / turn taking ────────────────────────────────────────────
VAD_STOP_SECS=0.5
VAD_MIN_SPEECH_MS=200
ALLOW_INTERRUPTIONS=true

# ── Entity resolution (tests, areas, branches, doctors...) ─────────────────
# Per-list overrides live in entities/<name>.yaml; these are the defaults.
ENTITY_CONFIG_DIR=./config/entities
ENTITY_DATA_DIR=./data
ENTITY_INDEX_DIR=./data/index
ENTITY_AUTO_ACCEPT_SCORE=0.90
ENTITY_ACCEPT_GAP=0.15
ENTITY_CONFIRM_SCORE=0.70
ENTITY_MAX_CHOICES=3
ENTITY_MAX_ROUNDS=2
ENTITY_USE_EMBEDDINGS=false
ENTITY_EMBEDDING_MODEL=
ENTITY_REFRESH_HOURS=24

# ── Dialog policy ───────────────────────────────────────────────────────────
MAX_SLOT_RETRIES=2
MAX_SUSPENDED_WORKFLOWS=2
HUMAN_TRANSFER_NUMBER=
DTMF_FALLBACK=true

# ── Backend / data ──────────────────────────────────────────────────────────
BOOKING_API_MODE=mock       # mock | live
BOOKING_API_URL=
BOOKING_API_KEY=
FAQ_FILE=./config/faq.yaml

# ── Safety / logging ────────────────────────────────────────────────────────
SHADOW_MODE=false           # true = bot proposes bookings but never submits
REDACT_PII_IN_LOGS=true
LOG_AUDIO=false
LOG_DIR=./logs

# ── App ─────────────────────────────────────────────────────────────────────
TZ=Asia/Karachi
UI_PORT=7860

# ── STT transport (HTTP batch is far more accurate than the realtime websocket per the repo benchmark notes) ──
STT_MODE=http                # http | ws
STT_HTTP_URL=https://ebitlogix-qwen-asr-vlm-async-test.hf.space
STT_VARIANT=chughtai         # chughtai (domain-tuned) | en
STT_TIMEOUT_S=30
# ── TTS websocket message format (adjust after running scripts/ping_endpoints.py) ──
TTS_FORMAT=auto              # auto | pcm_binary | json_base64
TTS_TEXT_FIELD=text
TTS_TIMEOUT_S=30
